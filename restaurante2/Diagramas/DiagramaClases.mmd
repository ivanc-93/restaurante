    class Program
    ElementoMenu <|-- Plato
    ElementoMenu <|-- Bebida
    IRepositorioRestaurante <|.. RepositorioRestaurante
    IConfiguracionConexion <|.. ConfiguracionConexion
    RepositorioRestaurante --> IConfiguracionConexion
    RepositorioRestaurante --> ReglasRestaurante
    RepositorioRestaurante ..> ElementoMenu
    SolicitudPedido *-- DetallePedidoSolicitud
    FormularioAcceso --> IRepositorioRestaurante
    FormularioAcceso --> IConfiguracionConexion
    FormularioPrincipal --> IRepositorioRestaurante
    FormularioPrincipal --> IConfiguracionConexion
    FormularioPrincipal --> UsuarioAutenticado
    FormularioPrincipal ..> FormularioMesa
    FormularioPrincipal ..> FormularioDetalleMesa
    FormularioPrincipal ..> FormularioCatalogos
    FormularioPrincipal ..> FormularioReportes
    FormularioDetalleMesa --> IRepositorioRestaurante
    FormularioDetalleMesa --> Mesa
    FormularioCatalogos --> IRepositorioRestaurante
    FormularioReportes --> IRepositorioRestaurante
    FormularioReportes ..> OpcionFiltro
    Program ..> CicloSesion
    Program ..> ConfiguracionConexionPruebas

    IDialogosUsuario <|.. DialogosUsuario
    IConfiguracionConexion <|.. ConfiguracionConexionPruebas
    CicloSesion ..> FormularioAcceso
    CicloSesion ..> FormularioPrincipal
    CicloSesion --> IDialogosUsuario
    FormularioPrincipal --> IDialogosUsuario
    FormularioDetalleMesa --> IDialogosUsuario
